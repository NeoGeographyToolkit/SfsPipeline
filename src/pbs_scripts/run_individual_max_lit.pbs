#!/bin/bash
#PBS -N pbs_max_lit
#PBS -j oe                      
#PBS -k oe                      
#PBS -l select=1:ncpus=20:model=ivy,walltime=08:00:00        
#PBS -q normal
#PBS -o pbs_max_lit.log
#PBS -r y                       
#PBS -S /bin/bash               
#PBS -V                         
#PBS -W group_list=e2305     
# Enable stepwise debugging if DEBUG is set to "true"
# Use queue "long" for jobs up to 120 hours
# Use queue "normal" for jobs up to 8 hours
# Use queue "low" for jobs up to 4 hours

# Enable stepwise debugging if DEBUG is set to "true"
if [[ "$DEBUG" == "true" ]]; then
    trap '(read -p "[$BASH_SOURCE:$LINENO] $BASH_COMMAND ")' DEBUG
fi
# define usage
USAGE="IMAGE_LIST=?,OUT_NAME=? $0"
# Ensure a IMAGE_LIST was provided
if [[ -z "$IMAGE_LIST" ]]; then
    echo "Error: IMAGE_LIST is not set. Use $USAGE"
    exit 1
fi
echo "IMAGE_LIST file: $IMAGE_LIST"
# OUT_NAME
if [[ -z "$OUT_NAME" ]]; then
    echo "Error: OUT_NAME is not set. Use $USAGE"
    exit 1
fi
echo "OUT_NAME file: $OUT_NAME"
# precompute the base filename for the output image
BASE=$(basename "$OUT_NAME")
# Ensure the work dir is set to something
if [[ -z "$WORKDIR" ]]; then
    # we will default to the current working directory wherever that is
    export WORKDIR="$PWD"
fi
echo "Workdir: $WORKDIR"
##############################################
# Check if the user want's this acutally submitted to PBS
if [[ -n $SUBMIT ]]; then
    # Tell user you requested to submit and then wait 15 seconds to allow user to exit just in case!
    echo "User requested to submit to PBS!!!!! You have 15 seconds to abort!!!"
    # unset SUBMIT so that this isn't recursive
    unset SUBMIT
    # unset DEBUG so that we don't debug inside the job
    unset DEBUG
    # echo SUBMIT and DEBUG as sanity check
    echo "DEBUG is $DEBUG and SUBMIT is $SUBMIT" 
    submit_name="pbs_run_max_lit_${BASE%%.tif}"
    echo "$submit_name"
    if [[ -z $NOSLEEP ]]; then
        # actually sleep if no sleep is not set
        sleep 15
    fi
    # submit to qsub
    exec qsub -N "$submit_name" -o "$WORKDIR/$submit_name.log" -V "$0"
    # be sure to exit the script at this point
    exit 0
fi
##############################################
# IF we are actually on PBS do another unset on DEBUG 
# just in case to avoid long waits for quick exits
if [[ -n $PBS_O_WORKDIR ]]; then
    # log
    echo "Checking current DEBUG variable value: $DEBUG"
    # unset it
    unset DEBUG
    # log
    echo "If DEBUG was not unset it should now be not set: $DEBUG"
fi
# Change to the working directory
echo Working directory is "$PBS_O_WORKDIR"
if [[ -n $PBS_O_WORKDIR ]]; then
    cd "$PBS_O_WORKDIR" || exit
fi
echo "machine is $(uname -a)"
echo "machine file is $PBS_NODEFILE"
##############################################
# source asp environment
source init_asp.sh
# echo out ISISDATA and ISISROOT
echo ISIS data is "$ISISDATA" 
echo ISIS root is "$ISISROOT"
# echo out PATH
echo PATH is "$PATH"
# save the path to dem_mosaic
DEM_MOSAIC=$(which dem_mosaic)
GDAL_TRANSLATE=$(which gdal_translate)
##############################################
# create output folders as needed
LOGS_FOLDER="$WORKDIR/logs"
JOBS_FOLDER="$WORKDIR/jobs"
mkdir -p "$LOGS_FOLDER"
mkdir -p "$JOBS_FOLDER"
# set log file
LOG_FILE="$LOGS_FOLDER/pbs_max_lit_${BASE%%.tif}_$(date +"%Y-%m-%d_%H-%M-%S")_log.txt"
# set the args for DEM mosaic
args_maxlit=(
            "$DEM_MOSAIC" 
            --max 
            --threads 32
        ) 
# use target projwin if provided
if [[ -n "$PROJWIN" ]]; then
    args_maxlit+=(--t_projwin "$PROJWIN")
fi
# append the list and out last
args_maxlit+=(-l "$IMAGE_LIST" -o "$OUT_NAME")
# set the args for converting to lerc cog
out_cog="${OUT_NAME%.tif}.lerc.cog.tif"
args_cog=(
   "$GDAL_TRANSLATE"
   --config GDAL_NUM_THREADS 38
   -co NUM_THREADS=38 
   -co COMPRESS=LERC_DEFLATE 
   -co MAX_Z_ERROR="0.00033" 
   -co PREDICTOR=3 
   -ot Float32 
   -of COG 
   "$OUT_NAME" 
   "$out_cog" 
)
# Combine both into one string
PROCESS_MOSAIC="${args_maxlit[@]}"
PROCESS_COG="${args_cog[@]}"
# prepare to run the command or print the debug
if [[ -z "$DEBUG" && -n $PBS_JOBID ]]; then 
    echo "Starting Job for $BASE at $(date)" >> "$LOG_FILE" 2>&1
    # run dem_mosaic
    eval "$PROCESS_MOSAIC" >> "$LOG_FILE" 2>&1
    # run gdal_translate to make a cog
    eval "$PROCESS_COG" >> "$LOG_FILE" 2>&1
    # The jobs have actually completed 
    echo "Finished Job for $BASE at $(date)" >> "$LOG_FILE" 2>&1
else
    # we are in debug mode so just log out the commands that would run
    echo "$PROCESS"
fi
# we are now done!
echo "Job finished at $(date)"  >> "$LOG_FILE" 2>&1