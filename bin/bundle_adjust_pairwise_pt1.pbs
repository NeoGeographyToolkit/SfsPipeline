#!/bin/bash
#PBS -N pbs_ba_pt1_pairwise
#PBS -j oe                      
#PBS -k oe                      
#PBS -l select=16:ncpus=128:model=rom_ait,walltime=08:00:00            
#PBS -q normal              
#PBS -m abe                     
#PBS -M andrew.m.annex@nasa.gov 
#PBS -o pbs_ba_pt1_pairwise.log   
#PBS -r y                       
#PBS -S /bin/bash               
#PBS -V                         
#PBS -W group_list=e2305    
# to complete this, run 156 nodes for 60 hours on long queue
# 78 nodes ran at roughly 5k pairs per hour (although this was highly variable, up to 80 per minute) 
# twelve nodes for 286 images and 1600 pairs took about 45 minutes wall time
# Use queue "long" for jobs up to 120 hours
# Use queue "normal" for jobs up to 8 hours
# Use queue "low" for jobs up to 4 hours
# Enable stepwise debugging if DEBUG is set to "true"
if [[ "$DEBUG" == "true" ]]; then
    trap '(read -p "[$BASH_SOURCE:$LINENO] $BASH_COMMAND ")' DEBUG
fi
# get the number of nodes (will typically be high)
if [[ -z "$NUM_NODES" ]]; then
    export NUM_NODES=16
fi;
echo "Using NUM_NODES $NUM_NODES"
# get the number of cpus per node
if [[ -z "$NUM_CPUS" ]]; then
    export NUM_CPUS=128
fi;
echo "Using NUM_CPUS $NUM_CPUS"
# get the model (node type)
if [[ -z "$MODEL" ]]; then
    export MODEL='rom_ait'
fi;
echo "Using MODEL $MODEL"
# get the walltime
if [[ -z "$WALLTIME" ]]; then
    export WALLTIME="8:00:00"
fi;
echo "Using WALLTIME $WALLTIME"
# get the queue (low, normal, long, ldan)
if [[ -z "$QUEUE" ]]; then
    export QUEUE="normal"
fi;
echo "Using QUEUE $QUEUE"
# define usage once
USAGE="qsub -v DEM=/path/to/dem.tif,OVERLAP_LIST=/path/to/overlap_list.txt,BA_PREFIX=ba0/run $0"
# Ensure a DEM was provided
if [ -z "$DEM" ]; then
    echo "Error: DEM is not set. Use $USAGE"
    exit 1
fi
echo "DEM file: $DEM"
# get overlap list file
if [[ -z "$OVERLAP_LIST" ]]; then
    echo "Error: OVERLAP_LIST is not set. Use $USAGE"
    exit 1
fi
echo "Path to overlap list: $OVERLAP_LIST"
# Ensure a output prefix is provided
if [[ -z "$BA_PREFIX" ]]; then
    echo "Error: BA_PREFIX is not set. Use $USAGE"
    exit 1
fi
echo "Output Prefix: $BA_PREFIX"
# If max pairwise matches isn't set, default to 2000
if [[ -z "$MAX_PAIRWISE_MATCHES" ]]; then
    export MAX_PAIRWISE_MATCHES=2000
    echo "Using MAX_PAIRWISE_MATCHES: $MAX_PAIRWISE_MATCHES"
fi
# Ensure the work dir is set to something
if [[ -z "$WORKDIR" ]]; then
    # we will default to the current working directory wherever that is
    export WORKDIR="$PWD"
fi
echo "Workdir: $WORKDIR"
# instead of the below, why not just make the commands file and don't delete it
# then submit after the file is made passing it as a variable to qsub for the 
# script to use
if [[ -z "$PARALLEL_JOBS_LIST_FILE" ]]; then
    echo "WARNING"
    echo "PARALLEL_JOBS_LIST_FILE is not specified. This isn't fatal,"
    echo "   as this script will generate this file for you. However,"
    echo "   for large bundle adjusts (>50k pairs) this is inadvisable"
    echo ""
    echo "To make the log file, on a PFE re-run this script with"
    echo "    DEBUG=true"
    echo "  And rename the $WORKDIR/launch_bundle_adjust_cmds.XXXXXX"
    echo "  temporary file before the script ends (you step through)"
    echo "  to ensure the file doesn't get deleted"
    echo ""
fi
##############################################
# Check if the user want's this acutally submitted to PBS
if [[ -n $SUBMIT ]]; then
    # Tell user you requested to submit and then wait 15 seconds to allow user to exit just in case!
    echo "User requested to submit to PBS!!!!! You have 15 seconds to abort!!!"
    # unset SUBMIT so that this isn't recursive
    unset SUBMIT
    # unset DEBUG so that we don't debug inside the job
    unset DEBUG
    # echo SUBMIT and DEBUG as sanity check
    echo "DEBUG is $DEBUG and SUBMIT is $SUBMIT" 
    # echo "$PARALLEL_JOBS_LIST_FILE"
    echo "JOB list was provided! Good on you!: $PARALLEL_JOBS_LIST_FILE"
    # submit to qsub
    submit_name="pbs_ba_pt1_pairwise_${BA_PREFIX%/*}"
    # evaluate the nodes,cpus,walltime
    node_cpu_wall="select=$NUM_NODES:ncpus=$NUM_CPUS:model=$MODEL,walltime=$WALLTIME" 
    # actually sleep
    sleep 15
    exec qsub -q "$QUEUE" -l "$node_cpu_wall" -N "$submit_name" -o "$WORKDIR/$submit_name.log" -V "$0"
    # be sure to exit the script at this point
    exit 0
fi
##############################################
# IF we are actually on PBS do another unset on DEBUG 
# just in case to avoid long waits for quick exits
if [[ -n $PBS_JOBID ]]; then
    # log
    echo "Checking current DEBUG variable value: $DEBUG"
    # unset it
    unset DEBUG
    # log
    echo "If DEBUG was not unset it should now be not set: $DEBUG"
fi
# Change to the working directory
echo Working directory is "$PBS_O_WORKDIR"
if [[ -n $PBS_O_WORKDIR ]]; then
    cd "$PBS_O_WORKDIR" || exit
fi
echo "machine is $(uname -a)"
echo "machine file is $PBS_NODEFILE"
# get the number of unique nodes 
if [[ -z "$PBS_NODEFILE" || ! -f "$PBS_NODEFILE" ]]; then
    NUM_NODES=1
else
    echo "machines are: $(cat $PBS_NODEFILE | sort -u)"
    NUM_NODES=$(sort -u "$PBS_NODEFILE" | wc -l)
    # create a new nodefile for gnu parallel
    # Create a temp file
    GNU_PARALLEL_NODEFILE=$(mktemp "$WORKDIR/pbs_ba_pt1_nodes.XXXXXX")
    # Ensure cleanup on exit or error
    trap 'rm -f "$GNU_PARALLEL_NODEFILE"' EXIT
    # write out the number of jobs per node 
    DEFAULT_JOBS=60
    LOCAL_JOBS=60
    LOCAL_HOST=$(hostname -s)
    # start the output file 
    # Append the local node with LOCAL_JOBS
    echo "${LOCAL_JOBS}/${LOCAL_HOST}" > "$GNU_PARALLEL_NODEFILE"
    # Write all other nodes with DEFAULT_JOBS
    sort -u "$PBS_NODEFILE" | grep -v "^$LOCAL_HOST\$" | while read NODE; do
        echo "${DEFAULT_JOBS}/${NODE}" >> "$GNU_PARALLEL_NODEFILE"
    done
fi
echo "running on $NUM_NODES nodes"
echo
##############################################
# source asp environment
source init_asp.sh
# echo out ISISDATA and ISISROOT
echo ISIS data is "$ISISDATA" 
echo ISIS root is "$ISISROOT"
# echo out PATH
echo PATH is "$PATH"
# save the path to mapproject
BUNDLE_ADJUST=$(which bundle_adjust)
###################################################
# create output folders as needed TODO: guard with check on debug?
LOGS_FOLDER="$WORKDIR/logs"
JOBS_FOLDER="$WORKDIR/jobs"
mkdir -p "$LOGS_FOLDER"
mkdir -p "$JOBS_FOLDER"
# set log file names
LOG_FILE="$LOGS_FOLDER/pbs_ba_pt1_pairwise_${BA_PREFIX%/*}_$(date +"%Y-%m-%d_%H-%M-%S")_log.txt"
JOB_FILE="$JOBS_FOLDER/pbs_ba_pt1_pairwise_${BA_PREFIX%/*}_job.log"
###################################################
# creating the parallel job list file
# if not present, create a tmpfile with it
# else proceed assuming its good to go 
if [[ -z "$PARALLEL_JOBS_LIST_FILE" ]]; then
    # perform all file existence checks once to avoid duplicative work
    declare -A file_ok
    # Extract unique images from both left and right columns
    # This produces the union of all image file paths.
    unique_images=$(awk '{print $1; print $2}' "$OVERLAP_LIST" | sort -u)
    echo "Performing pre-check on unique cameras, images, and map projected image files. Start $(date)"
    {
        trap '' DEBUG
        for img in $unique_images; do
            # Use parameter expansion to get parent dir and base name:
            parent="${img%/*}"
            base="${img##*/}"
            base_no_ext="${base%.cub}"
            # Construct paths for the auxiliary files:
            cam="${parent}/${base_no_ext}.json"
            map="${parent}/${base_no_ext}.map.noba.tif"
            # Check the image file
            if [[ -f "$img" ]]; then
                file_ok["$img"]=1
            else
                file_ok["$img"]=0
                echo "Image not found: $img"
            fi
            # Check the camera JSON file
            if [[ -f "$cam" ]]; then
                file_ok["$cam"]=1
            else
                file_ok["$cam"]=0
                echo "Camera file not found: $cam"
            fi
            # Check the map projected file
            if [[ -f "$map" ]]; then
                file_ok["$map"]=1
            else
                file_ok["$map"]=0
                echo "Map projected image not found: $map"
            fi
        done
        #
        if [[ "$DEBUG" == "true" ]]; then
            trap '(read -p "[$BASH_SOURCE:$LINENO] $BASH_COMMAND ")' DEBUG
        fi
    }
    echo "file_ok has ${#file_ok[@]} keys, finished checks at $(date)"
    # Create a temp file
    TMPFILE=$(mktemp "$WORKDIR/launch_bundle_adjust_cmds.XXXXXX")
    # Ensure cleanup on exit or error
    trap 'rm -f "$TMPFILE"' EXIT
    echo "Start building jobs list: $(date)"
    # Generate commands dynamically and store in temp file
    {
    trap '' DEBUG
    while read -r LIMG RIMG; do
        # Get the base names without external commands
        parent_dir="${LIMG%/*}"
        LBASE="${LIMG##*/}"
        RBASE="${RIMG##*/}"
        LBASE_NO_EXT="${LBASE%.cub}"
        RBASE_NO_EXT="${RBASE%.cub}"
        # Construct the auxiliary file names
        LCAM="${parent_dir}/${LBASE_NO_EXT}.json"
        RCAM="${parent_dir}/${RBASE_NO_EXT}.json"
        LMAP="${parent_dir}/${LBASE_NO_EXT}.map.noba.tif"
        RMAP="${parent_dir}/${RBASE_NO_EXT}.map.noba.tif"
        MAPPROJ_DATA_STR="'${LMAP} ${RMAP} ${DEM}'"
        # Instead of repeated file tests, we now look up results from file_ok.
        if [[ ${file_ok["$LIMG"]} -ne 1 ]]; then
            echo "LEFT image not found!: $LIMG"
            continue
        elif [[ ${file_ok["$RIMG"]} -ne 1 ]]; then
            echo "RIGHT image not found!: $RIMG"
            continue
        elif [[ ${file_ok["$LCAM"]} -ne 1 ]]; then
            echo "LEFT camera not found!: $LCAM"
            continue
        elif [[ ${file_ok["$RCAM"]} -ne 1 ]]; then
            echo "RIGHT camera not found!: $RCAM"
            continue
        elif [[ ${file_ok["$LMAP"]} -ne 1 ]]; then
            echo "LEFT mapprojected image not found!: $LMAP"
            continue
        elif [[ ${file_ok["$RMAP"]} -ne 1 ]]; then
            echo "RIGHT mapprojected image not found!: $RMAP"
            continue
        else
            # 3 threads are used as memory usage seems proportional to thread count
            # 4 was a bit too much causing as much as 11% ram use vs 7-8% for 3 threads
            # 2 threads used up to 6% or so but I think it's crashed before even then and 10 workers
            args=(
                "$BUNDLE_ADJUST"
                "$LIMG" 
                "$RIMG" 
                "$LCAM" 
                "$RCAM"
                --mapproj-dem "$DEM"      
                --mapprojected-data "$MAPPROJ_DATA_STR"  
                --stop-after-matching      
                --threads 3              
                --nodata-value 0.001      
                --ip-detect-method 1      
                --ip-per-tile  500
                --matches-per-tile 100
                --matches-per-tile-params 512 768             
                --num-iterations 500      
                --num-passes 4            
                --min-matches 10          
                --max-pairwise-matches "$MAX_PAIRWISE_MATCHES"
                --camera-weight 0           
                --save-intermediate-cameras 
                --robust-threshold 2.0      
                --tri-weight 0.1            
                --tri-robust-threshold 0.25 
                --min-triangulation-angle 0.1 
                --remove-outliers-params "'75.0 3.0 100 100'"
                -o "$BA_PREFIX"
            )
        fi
        # first write out the parallel stereo command but first make the output dir so I can capture the logs per job
        echo "${args[@]}"  >> "$TMPFILE";
        # okay 
    done < <(paste "$OVERLAP_LIST")
    # sort the TMPFILE to ensure repeatability
    sort -o "$TMPFILE"{,}
    #
    if [[ "$DEBUG" == "true" ]]; then
        trap '(read -p "[$BASH_SOURCE:$LINENO] $BASH_COMMAND ")' DEBUG
    fi
    }
    echo "Finished building jobs list: $(date)"
    # set the PARALLEL_JOBS_LIST_FILE
    PARALLEL_JOBS_LIST_FILE="$TMPFILE"
fi

# start call
if [[ -z "$DEBUG" && -n $PBS_JOBID ]]; then 
    echo "Log File: "
    echo "$LOG_FILE"
    echo "Job File: "
    echo "$JOB_FILE"
    echo "Parallel has started at $(date)"
    # Run GNU Parallel with the temp file if not in debug mode
    parallel_opts=(
        -u 
        -a "$PARALLEL_JOBS_LIST_FILE"
        --workdir "$WORKDIR"
        --memfree 10G
        --retries 10
        --resume-failed 
        --keep-order
        --joblog "$JOB_FILE"
    )
    if [[ $NUM_NODES -gt 1 ]]; then
        parallel_opts+=(
            --controlmaster 
            --sshdelay 0.01 
            --sshloginfile "$GNU_PARALLEL_NODEFILE"
        )
    else
        parallel_opts+=(
            --jobs "$DEFAULT_JOBS"
        )
    fi
    # echo out parallel opts
    echo "Using these opts for parallel: "
    echo "${parallel_opts[@]}"
    # start gnu parallel
    $ASPROOT/bin/parallel "${parallel_opts[@]}" &> "$LOG_FILE"
    # The jobs have actually completed 
    echo "Parallel has finished with all jobs at $(date)"
    # move the joblog file to preserve its state and to avoid re-running it
    mv "$JOB_FILE" "$JOBS_FOLDER/completed_$(date +"%Y-%m-%d_%H-%M-%S")_${JOB_FILE##*/}"
else
    # I am debugging of a pfe or something
    echo "would have run: "
    cat "$PARALLEL_JOBS_LIST_FILE"
fi
# we are now done!
echo "Job finished at $(date)"
